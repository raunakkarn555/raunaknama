# Copy this file to .env and fill in your own values.
# All of these come from Firebase console -> Project settings -> General
# -> "Your apps" -> the web app's SDK config snippet.
# See README section 2 for exact steps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Realtime Database URL — from Firebase console -> Realtime Database ->
# top of the data page. Looks like:
# https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=

# The API is now served from this same site via Netlify Functions
# (netlify/functions/*, exposed at /api/* through the redirect in
# netlify.toml). Leave this blank unless the API is hosted elsewhere.
VITE_API_BASE_URL=

# Site-wide password gate (netlify/functions/auth.mjs). These are SERVER
# secrets — set them in the Netlify dashboard (Site settings -> Environment
# variables) for production, and here in your local .env for `netlify dev`.
# They are never sent to the browser and never appear in the frontend bundle.
#
# The password visitors must type to get in.
SITE_PASSWORD=
# A random secret used to sign the 7-day session cookie so it can't be
# forged. Generate one with: openssl rand -hex 32
SITE_AUTH_SECRET=

# --- Stream resolver (netlify/functions/stream.mjs) ---
# Piped backup is OFF unless you list working instances here (comma-separated
# base URLs). The old built-in public instances were dead (502/525/403) and
# only added latency, so there is no default list any more.
PIPED_API_INSTANCES=
# Secret used to sign audio-proxy URLs (falls back to SITE_AUTH_SECRET).
AUDIO_PROXY_SECRET=
# Resolver clients served through /.netlify/functions/audio-proxy.
# "*" (default) = all googlevideo URLs (they are bound to the resolving IP and
# client User-Agent, so a browser fetching them directly gets 403).
AUDIO_PROXY_CLIENTS=*
# Set to 1 to disable BotGuard PO-token minting (bgutils-js).
PO_TOKEN_DISABLED=0
# Set to 0 to silence the per-client timing logs ([youtubei]/[piped]/[stream]).
STREAM_LOG=1

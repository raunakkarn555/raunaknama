# Copy this file to .env and fill in your own values.
# All of these come from Firebase console -> Project settings -> General
# -> "Your apps" -> the web app's SDK config snippet.
# See README section 2 for exact steps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Realtime Database URL — from Firebase console -> Realtime Database ->
# top of the data page. Looks like:
# https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=

# URL of the backend server (the /server folder), once deployed.
# Local dev: leave blank, it falls back to http://localhost:5000
# Production: set this to your deployed backend, e.g.
# https://raunaknama-server.onrender.com
VITE_API_BASE_URL=
